{
	"name": "@escemi-tech/github-briefing",
	"version": "0.1.0",
	"private": true,
	"description": "Scoped account-wide GitHub work evidence for private briefings",
	"license": "MIT",
	"type": "module",
	"exports": "./src/github-briefing.js",
	"scripts": {
		"briefing": "node src/adapters/cli.js",
		"test": "node --test",
		"pretest:ci": "node -e \"require('node:fs').mkdirSync('.reports', { recursive: true })\"",
		"test:ci": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-reporter=junit --test-reporter-destination=.reports/junit.xml --test-reporter=lcov --test-reporter-destination=.reports/lcov.info"
	},
	"dependencies": {
		"@octokit/rest": "22.0.1",
		"zod": "4.6.7"
	}
}
