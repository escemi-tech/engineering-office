# Docker Compose dotenv: quote strings and preserve literal dollar signs.
HERMES_GATEWAY_API_KEY={{ hermes_runtime.gateway_api_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
HERMES_INFERENCE_API_KEY={{ hermes_runtime.inference_api_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
HERMES_INFERENCE_URL={{ hermes_runtime.inference_url | replace('$', '$$') | to_json(ensure_ascii=False) }}
HERMES_MODEL={{ hermes_runtime.model | replace('$', '$$') | to_json(ensure_ascii=False) }}
