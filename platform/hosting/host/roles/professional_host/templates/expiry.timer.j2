# Managed by engineering-office {{ professional_host_scope }}
# Controller: {{ professional_host_root }}
[Unit]
Description=Expire the approved engineering-office {{ professional_host_scope }} run

[Timer]
OnCalendar={{ professional_host_run.expires_at | regex_replace('T', ' ') | regex_replace('Z$', ' UTC') }}
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
